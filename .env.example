# election-map — copy to .env and adjust. On <HOST>: <DEPLOY_DIR>/.env
# Create it once by hand; the deploy workflow requires it but never creates or edits it.
#
# There are NO secrets: every results source is a public feed. This file only holds host settings.

# Host port published for the app (the container always listens on 3710).
ELECTION_MAP_PORT=3710
# Host address the port binds to: <HOST>'s LAN IP, which the Cloudflare tunnel points at.
# Never 0.0.0.0. The deploy health probe also reads ELECTION_MAP_PORT from this file.
ELECTION_MAP_BIND_IP=<LAN_IP>

# Container user. <HOST_OS>'s nobody:users is 99:100. Match the owner of
# <DEPLOY_DIR>/data so the app can write its database.
PUID=99
PGID=100

# How often each results source is polled.
POLL_INTERVAL_SECONDS=60
# debug | info | warn | error
LOG_LEVEL=info
