# election-map — copy to .env (next to docker-compose.yml) and adjust.
# The Gitea deploy workflow requires a .env in the deploy dir but never creates or edits it.
#
# There are NO secrets: every results source is a public feed. This file only holds host settings.

# Host port published for the app (the container always listens on 3710).
ELECTION_MAP_PORT=3710
# Host address the port binds to. Never 0.0.0.0. 127.0.0.1 = this machine only; use the host's
# LAN address if a reverse proxy or tunnel on another machine forwards to it.
# The deploy health probe also reads ELECTION_MAP_BIND_IP / ELECTION_MAP_PORT from this file.
ELECTION_MAP_BIND_IP=127.0.0.1

# Container user (uid:gid). Match the owner of ./data so the app can write its database.
PUID=1000
PGID=1000

# How often each results source is polled (seconds, minimum 15).
POLL_INTERVAL_SECONDS=60
# debug | info | warn | error
LOG_LEVEL=info
